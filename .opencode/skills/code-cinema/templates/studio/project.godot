; Code Cinema studio project.
; Engine configuration file.

config_version=5

[application]

config/name="Code Cinema Studio"
run/main_scene="res://code_cinema/player.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.015, 0.018, 0.024, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_debanding=true
environment/defaults/default_clear_color=Color(0.015, 0.018, 0.024, 1)
textures/default_filters/use_nearest_mipmap_filter=false

[editor]

movie_writer/fps=30
movie_writer/mjpeg_quality=0.9

[audio]

driver/enable_input=false
